APP_ENV=development
APP_NAME=TCS Biospecimen Platform

DATABASE_URL=postgresql+psycopg://biospecimen:biospecimen@postgres:5432/biospecimen
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRY_MINUTES=480
UPLOAD_DIR=/data/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

POSTGRES_USER=biospecimen
POSTGRES_PASSWORD=biospecimen
POSTGRES_DB=biospecimen
POSTGRES_PORT=5432

BACKEND_PORT=8000
FRONTEND_PORT=5173
